,"x":7.4,"z":9.6,"w":0.9,"d":0.9,"h":1.5}],"ground":[{"kind":"disc","name":"the square","x":0,"z":0,"r":7},{"kind":"path","name":"lane west","a":[-6,0.3],"b":[-17,0.8],"w":4.2},{"kind":"path","name":"lane east","a":[6,0.3],"b":[17,0.8],"w":4.2}],"flats":[{"kind":"box","tone":"cloth","name":"the Jester's floor cloth","x":0,"z":-3.6,"w":4.4,"d":3.0}],"exits":[],"people":[{"id":"ballad-singer","name":"The ballad-singer","x":0.0,"z":-3.618,"says":["You four are on after me. I'll keep the long one short.","The candles keep leaning. There's no wind.","The oldest song I know is about a light on the crag. It has no last verse. Nobody ever wrote one."],"doing":"stands on the rug singing among the leaning candles; stops and bows when spoken to"},{"id":"old-lamp-seller","name":"The lamp-seller","x":-3.003,"z":6.592,"says":["Evening, you four. Come and look. Every flame on my counter is leaning the same way.","There's no wind. I licked my finger twice to be sure.","Take this wick out to the lamplighter at the Last Lantern? It's for her dead post. She never gives up on that post."],"doing":"sits on a stool behind the counter trimming wicks, glancing at her flames; beckons when the party comes near"},{"id":"ribbon-dyer","name":"The ribbon-dyer","x":2.594,"z":-8.187,"says":["The one with the fox ears bought all my blue. She said she felt a lot of sewing coming on.","My steam goes straight up every night. Tonight it leans toward the gate."],"doing":"stands stirring a dye pot, watching its steam lean toward the gate; greets with a bow, thinks before answering"},{"id":"fortune-teller","name":"The fortune-teller","x":6.605,"z":-6.179,"says":["One coin, one card. You travel with us and you've never once sat down.","A fire with nobody sitting by it. It's a bad card. It's always been a bad card."],"doing":"stands in the doorway turning one card over and over; beckons"}],"spots":[{"kind":"rest","label":"The party's wagon","at":[-4.404,7.584]}],"lamps":[[6.98,-3.71,2.85],[3.71,-6.98,2.85],