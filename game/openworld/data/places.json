ox","name":"oven cart","x":-8.6,"z":-3.5,"w":2.4,"d":1.5,"h":1.7,"turn":0,"tone":"stone"},{"kind":"stall","name":"awning stall left of the ring","x":-5.6,"z":-3.6,"w":3,"d":1.7,"h":2.3,"turn":0},{"kind":"stall","name":"awning stall right of the ring","x":5.6,"z":-3.6,"w":3,"d":1.7,"h":2.3,"turn":0},{"kind":"box","name":"pie cart","x":8.7,"z":-3.4,"w":2.2,"d":1.2,"h":1.1,"turn":0,"tone":"wood"},{"kind":"post","name":"ring lamp post, near left corner","x":-3.6,"z":-2.3,"h":2.8},{"kind":"post","name":"ring lamp post, near right corner","x":3.6,"z":-2.3,"h":2.8},{"kind":"box","name":"straw bales","x":-5,"z":5,"w":2.4,"d":0.9,"h":0.6,"turn":0,"tone":"wood"},{"kind":"box","name":"low hitching rail","x":0,"z":5.6,"w":5,"d":0.15,"h":0.9,"turn":0,"tone":"wood"},{"kind":"box","name":"stacked crates","x":5.5,"z":5.9,"w":1.6,"d":1.2,"h":0.9,"turn":0,"tone":"wood"}],"ground":[{"kind":"box","name":"the stall row lane","x":0,"z":0.5,"w":22,"d":5,"turn":0},{"kind":"box","name":"the sawdust ring","x":0,"z":-5,"w":6.4,"d":6,"turn":0},{"kind":"path","name":"the ring mouth","a":[0,-3],"b":[0,-1],"w":3}],"flats":[{"kind":"box","name":"trampled grass verge on the near side of the lane","tone":"grass","x":0,"z":5.7,"w":20,"d":4.8,"turn":0},{"kind":"box","name":"the field beginning past the last stall","tone":"grass","x":10.8,"z":-6.5,"w":3.5,"d":7,"turn":0}],"exits":[{"to":"W1","side":"left","x":-10,"z":0.5},{"to":"W3","side":"right","x":10,"z":0.5}],"people":[{"id":"fair-baker","name":"The baker","x":-8.604,"z":-1.296,"says":["Buns are just out. Mind, they're hot.","My oven's drawing like it wants to leave. It's never done that before.","If they come for my oven they'll get the peel across the nose. Do they have noses?"],"doing":"stands at the oven door, frowning at the fire pulling up the flue; waves a floury hand, laughs easily"},{"id":"old-night-watchman","name":"The night watchman","x":3.8,"z":-0.79,"says":["Shutters first, then lamps. Tonight the lamps keep going out behind me.","They don't come for you. They stop at the ring lamps on their way somewhere. You're just standing in it.","Knocked flat? You'll wake up by your wagon. No shame in it. Go again."],"doing":"stands at a corner post of the ring watching its four lamps; nods, points at the ring"},{"id":"pie-seller","name":"The pie-seller","x":8.496,"z":-1.211,"says":["Hot pies! Mutton, and the other one's mutton too.","Something cold went past my cart and my lamp went out. Like a draught with nobody in it.","That captain's had nothing since noon. Take him one, he's good for the coin."],"doing":"stands behind the cart; waves, points at the pies, then at the gate"}],"spots":[],"lamps":[[-3.6,-8.4,2.35],[3.6,-8.4,2.35],[-3.6,-2.3,2.35],[3.6,-2.3,2.35]],"happens":[{"code":"W2-a","title":"Wisps at the ring lamps","kind":"fight"},{"code":"W2-b","title":"Practice bouts in the ring","kind":"fight"},{"code":"W2-c","title":"A pie for the captain","kind":"errand"},{"code":"W2-d","title":"The watchman's advice","kind":"talk"},{"code":"W2-e","title":"Not after us","kind":"scene"}]},"W3":{"id":"W3","name":"The mooring field","zone":1,"light":"dusk","at":[-148.0,96.5],"base":3.0,"camera":{"fov":12,"pitch":24,"target":[0,0,-2.5],"span":10.7},"skyBand":0.15,"moon":{"u":0.105,"v":0.072,"d":0.085},"camPos":[0,20.7036,44.0012],"figure":[0,-1],"foot":[[-8.66,8.14],[8.66,8.14],[12.77,-13.28],[-12.77,-13.28]],"solids":[{"kind":"box","name":"airship hull, stern end","tone":"hull","x":5.7,"z":-10,"w":4.2,"d":3,"h":2.4,"y":0.3,"turn":0},{"kind":"box","name":"airship hull","tone":"hull","x":9.9,"z":-10,"w":4.2,"d":3,"h":2.4,"y":0.3,"turn":0},{"kind":"box","name":"ship's ladder","tone":"wood","x":3.2,"z":-11.4,"w":0.5,"d":0.16,"h":2.7,"turn":0},{"kind":"cyl","name":"mooring post","x":-1.1,"z":-10.0,"r":0.2,"h":1.1},{"kind":"cyl","name":"mooring post","x":2.9,"z":-7.9,"r":0.2,"h":1.1},{"kind":"tent-round","name":"tent back","x":-10,"z":-6,"r":2.2,"wall":1.8,"top":3.2},{"kind":"tent-square","name":"last tent back","x":